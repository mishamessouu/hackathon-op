# ApogeoAPI key. Either spelling is accepted.
# Without a key the backend serves offline fixture facts for 12 countries so
# the game stays playable.
APOGEO_API_KEY=replace-with-your-key
# APOGEOAPI_KEY=replace-with-your-key

# Optional: override if the country list moves.
# APOGEO_API_URL=https://api.apogeoapi.com/v1/countries

# Encrypts the round token. Any string works; it is hashed into a Fernet key.
# Must be set in production, or rounds break when a new process starts.
GAME_SECRET=change-me-to-a-long-random-string
